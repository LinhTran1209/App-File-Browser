[Unit]
Description=File Server video thumbnail companion
After=network-online.target filebrowser.service
Wants=network-online.target

[Service]
Type=simple
User=linh3
Group=linh3
ExecStart=/opt/file-server-thumbnail/file-server-thumbnail -listen 0.0.0.0:8890 -root /media -cache /var/cache/file-server-thumbnail -filebrowser http://127.0.0.1:8888
Restart=on-failure
RestartSec=3
CacheDirectory=file-server-thumbnail
CacheDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/media
ReadWritePaths=/var/cache/file-server-thumbnail
MemoryMax=180M
CPUWeight=20
Nice=15
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
